<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>mdml</title>
    <organization>dev.mdml</organization>
    <options customize="never" require-scripts="false" hostArchitectures="@ARCH@"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <pkg-ref id="dev.mdml.converter"/>
    <choices-outline>
        <line choice="default">
            <line choice="dev.mdml.converter"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="dev.mdml.converter" visible="false">
        <pkg-ref id="dev.mdml.converter"/>
    </choice>
    <pkg-ref id="dev.mdml.converter" version="@VERSION@" onConclusion="none">mdml-component.pkg</pkg-ref>
</installer-gui-script>
